# Required environment variables for Message Notification Router
# Copy this file to .env in the repo root and fill in your values.
# NEVER commit .env to git.

# ── Gemini (required for multimodal messages: image + audio) ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ── Groq (optional but recommended — high RPM for text-only messages) ──
# Get a free key at https://console.groq.com
# Text-only messages will use Groq; image/audio messages always use Gemini.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
